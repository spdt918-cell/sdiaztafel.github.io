<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Contact · Sebastian Diaz-Tafel</title>
  <link rel="icon" type="image/png" href="img/headshot.png" />
  <link rel="stylesheet" href="css/site.css?v=11" />
  <style>
    .contact-wrap {
      max-width: 560px;
      padding: 48px 0 64px;
    }
    .page-eyebrow {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 10px;
      display: block;
    }
    .contact-wrap h1 {
      font-size: 32px;
      margin: 0 0 10px;
      line-height: 1.2;
    }
    .contact-wrap .lede {
      color: var(--muted);
      font-size: .95rem;
      line-height: 1.7;
      margin: 0 0 32px;
    }

    /* ── Social links ── */
    .social-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 36px;
    }
    .social-link {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: .85rem;
      font-weight: 600;
      color: var(--text);
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px 14px;
      transition: border-color .15s, color .15s;
      text-decoration: none;
    }
    .social-link:hover {
      border-color: var(--accent);
      color: var(--accent);
      text-decoration: none;
    }
    .social-link svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      fill: currentColor;
    }

    /* ── Form ── */
    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .field label {
      font-size: .8rem;
      font-weight: 600;
      color: var(--muted);
      letter-spacing: .04em;
      text-transform: uppercase;
    }
    .field input,
    .field textarea {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 14px;
      font-size: .92rem;
      color: var(--text);
      font-family: inherit;
      transition: border-color .15s;
      outline: none;
      resize: none;
    }
    .field input:focus,
    .field textarea:focus {
      border-color: var(--accent);
    }
    .field input::placeholder,
    .field textarea::placeholder {
      color: var(--muted);
      opacity: .6;
    }
    .field textarea {
      min-height: 130px;
    }
    .form-divider {
      border: none;
      border-top: 1px solid var(--border);
      margin: 4px 0;
    }
    .form-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
    }
    .form-note {
      font-size: .8rem;
      color: var(--muted);
    }
    .form-note a {
      color: var(--accent);
    }
    .submit-btn {
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      color: #0b0c10;
      font-weight: 700;
      font-size: .9rem;
      border: none;
      border-radius: 10px;
      padding: 10px 24px;
      cursor: pointer;
      font-family: inherit;
      transition: opacity .15s;
    }
    .submit-btn:hover { opacity: .85; }

    @media (max-width: 520px) {
      .form-row { grid-template-columns: 1fr; }
      .form-footer { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>
<div class="container">

  <header class="site-header">
    <nav class="nav">
      <div class="brand">
        <img src="img/headshot.png" alt="Sebastian Diaz-Tafel headshot" />
        <span>Sebastian Diaz-Tafel</span>
      </div>
      <ul>
        <li><a href="index.html">Home</a></li>
        <li><a href="portfolio.html">Portfolio</a></li>
        <li><a class="active" href="contact.html">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <div class="contact-wrap">
      <span class="page-eyebrow">Get In Touch</span>
      <h1>Contact</h1>
      <p class="lede">
        If you have a question, want to talk about a role, or just want to connect, feel free
        to reach out. I check my email regularly and will get back to you soon.
      </p>

      <!-- Social links -->
      <div class="social-row">
        <a class="social-link" href="mailto:spdt918@gmail.com">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20 4H4C2.9 4 2 4.9 2 6v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
          spdt918@gmail.com
        </a>
        <a class="social-link" href="https://www.linkedin.com/in/sdiaztafel" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
      </div>

      <!-- Contact form -->
      <form class="contact-form" action="mailto:spdt918@gmail.com" method="GET" enctype="text/plain">
        <div class="form-row">
          <div class="field">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" placeholder="Your name" required />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="your@email.com" required />
          </div>
        </div>
        <div class="field">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" placeholder="What is this about?" />
        </div>
        <div class="field">
          <label for="body">Message</label>
          <textarea id="body" name="body" placeholder="Your message..."></textarea>
        </div>
        <hr class="form-divider" />
        <div class="form-footer">
          <span class="form-note">Opens your default email client to send.</span>
          <button type="submit" class="submit-btn">Send Message</button>
        </div>
      </form>
    </div>
  </main>

  <footer class="site-footer">
    © <span id="y"></span> Sebastian Diaz-Tafel • <a href="mailto:spdt918@gmail.com">spdt918@gmail.com</a>
  </footer>

</div>
<script>document.getElementById('y').textContent = new Date().getFullYear()</script>
</body>
</html>
